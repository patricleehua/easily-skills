# Hyperliquid API Configuration
# 主网或测试网配置

# 网络环境: mainnet 或 testnet
HL_NETWORK=testnet

# 钱包地址 (必需)
HL_ACCOUNT_ADDRESS=0x...

# 私钥 (必需，用于签名交易)
HL_SECRET_KEY=0x...

# 可选: API钱包私钥 (通过 https://app.hyperliquid.xyz/API 生成)
HL_API_SECRET_KEY=

# 日志级别: DEBUG, INFO, WARNING, ERROR
HL_LOG_LEVEL=INFO

# 表格渲染语言设置: en 或 zh-CN
HL_LANGUAGE=en